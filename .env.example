# Copy to .env and fill in. Never commit .env.
# Create an Unsplash developer app at https://unsplash.com/oauth/applications
# Redirect URI: http://127.0.0.1:8787/callback
# Scopes: public read_user write_photos write_collections

UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_USER_TOKEN=
UNSPLASH_REDIRECT_URI=http://127.0.0.1:8787/callback
UNSPLASH_USERNAME=liuxuedi

# Optional. Leave blank, or pass --no-ai, to skip the LLM entirely.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Required by the Nominatim usage policy. Identify this app.
NOMINATIM_USER_AGENT=unsplash-photo-workflow/0.1 (hobby photographer; local use)

# Web UI only (see README). Do not put these in git.
# UPW_PASSWORD=
# UPW_SESSION_SECRET=
# DATABASE_URL=
# SENTRY_DSN=
